
FROM node:22-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ARG VITE_NODE_ENV
ARG VITE_NODE_PUBLIC_URL
ARG VITE_NODE_BUILD_VERSION
ARG VITE_DEFAULT_LANGUAGE
ARG VITE_API_URL
ARG VITE_TELEGRAM_CHAT_ID
ARG VITE_HOTJAR_ID
ARG VITE_TURNSTILE_SITE_KEY
ARG VITE_API_CLIENT_KEY
ARG VITE_API_CLIENT_SECRET
ARG VITE_API_SECRET_KEY
ARG VITE_TELEGRAM_BOT_TOKEN

ENV VITE_NODE_ENV=$VITE_NODE_ENV
ENV VITE_NODE_PUBLIC_URL=$VITE_NODE_PUBLIC_URL
ENV VITE_NODE_BUILD_VERSION=$VITE_NODE_BUILD_VERSION
ENV VITE_DEFAULT_LANGUAGE=$VITE_DEFAULT_LANGUAGE
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_TELEGRAM_CHAT_ID=$VITE_TELEGRAM_CHAT_ID
ENV VITE_HOTJAR_ID=$VITE_HOTJAR_ID
ENV VITE_TURNSTILE_SITE_KEY=$VITE_TURNSTILE_SITE_KEY
ENV VITE_API_CLIENT_KEY=$VITE_API_CLIENT_KEY
ENV VITE_API_CLIENT_SECRET=$VITE_API_CLIENT_SECRET
ENV VITE_API_SECRET_KEY=$VITE_API_SECRET_KEY
ENV VITE_TELEGRAM_BOT_TOKEN=$VITE_TELEGRAM_BOT_TOKEN

RUN npm run build

FROM nginx:alpine AS production

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
